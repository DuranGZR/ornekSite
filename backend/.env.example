NODE_ENV=development
HOST=127.0.0.1
PORT=4400
APP_ORIGIN=http://127.0.0.1:4400
# Local only: embedded PostgreSQL, no Docker required. Production requires DATABASE_URL.
LOCAL_DATABASE_PATH=./var/database
DATABASE_URL=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
# Production: set a separate HTTPS panel origin and explicit private DB TLS configuration.
DATABASE_SSL=false
TRUST_PROXY=false
# Export only public, published data to the Astro build.
CONTENT_EXPORT_PATH=../frontend/src/content/published.json
MEDIA_EXPORT_PATH=../frontend/public/managed-media
