---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import { events, articles } from '../content/data';
---

<Base>
  <Hero />
  <section class="intro-section wrap" id="kesfet" data-reveal>
    <p class="eyebrow">01 / BİZİ BİR ARAYA GETİREN</p>
    <div>
      <h2>
        Merak ortaksa,
        <br />
        olasılıklar <em>sınırsız.</em>
      </h2>
      <div class="intro-copy">
        <p>
          Bir soruyla başlar her şey. Sonra bir sohbet, bir fikir, bir deneme.
          HSD İnönü, teknolojiye ilgi duyan insanların birlikte öğrenmek ve
          üretmek için buluştuğu yer.
        </p>
        <a class="text-link" href="/topluluk/">
          Topluluğu tanı <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="events-section wrap" data-reveal>
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / AYNI YERDE, AYNI HEYECAN</p>
        <h2>
          Bir araya
          <br />
          gelelim.
        </h2>
      </div>
      <a class="pill outline" href="/etkinlikler/">
        Tüm etkinlikler ↗
      </a>
    </div>
    <div class="event-grid">
      {events.slice(0, 2).map((event) => (
        <EventCard event={event} />
      ))}
    </div>
  </section>
  <section class="manifesto" data-reveal>
    <p class="eyebrow">ÖĞRENMEK BİR BAŞLANGIÇ.</p>
    <h2>
      Asıl mesele,
      <br />
      <span>birlikte</span> yapmak.
    </h2>
    <a class="pill light" href="/katil/">
      Sen de bir parçası ol ↗
    </a>
    <span class="manifesto-mark" aria-hidden="true">
      ✳
    </span>
  </section>
  <section class="wrap writing-section" data-reveal>
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / TOPLULUKTAN NOTLAR</p>
        <h2>
          Fikirler burada
          <br />
          çoğalır.
        </h2>
      </div>
      <a class="text-link" href="/yazilar/">
        Bütün yazılar ↗
      </a>
    </div>
    {articles.map((article, i) => (
      <a
        class="article-row"
        href={article.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="row-index">0{i + 1}</span>
        <div>
          <span class="eyebrow">{article.category}</span>
          <h3>{article.title}</h3>
        </div>
        <span class="row-arrow">↗</span>
      </a>
    ))}
  </section>
</Base>
