---
import CoverImage from './CoverImage.astro';
import { eventDate } from '../utils/date';
import type { initialArticles } from '../content/data';
interface Props {
  articles: typeof initialArticles;
  compact?: boolean;
}
const { articles, compact = false } = Astro.props;
const sorted = [...articles].sort((a, b) =>
  b.published.localeCompare(a.published),
);
const Heading = compact ? 'h3' : 'h2';
---

{sorted.length > 0 ? (
  <div class="journal-grid">
    {sorted.map((article, index) => (
      <a
        class:list={[
          'journal-article',
          { 'journal-featured': index === 0, 'journal-extra': index >= 3 },
        ]}
        href={article.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="journal-cover">
          <CoverImage
            src={
              index === 0
                ? article.cover.replace('480:318', '960:636')
                : article.cover
            }
            loading={!compact && index === 0 ? 'eager' : 'lazy'}
          />
          <span class="journal-issue" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          {index === 0 && <span class="journal-latest">SON YAZI</span>}
        </div>
        <div class="journal-copy">
          <p class="journal-category">
            {article.category}
            <span>{article.readingMinutes} dk okuma</span>
          </p>
          <Heading>{article.title}</Heading>
          {index === 0 && (
            <p class="journal-description">{article.description}</p>
          )}
          <div class="journal-bottom">
            <div>
              <span>{article.author}</span>
              <time datetime={article.published}>
                {eventDate(article.published)}
              </time>
            </div>
            <span class="journal-arrow" aria-hidden="true">
              ↗
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
) : (
  <p class="journal-empty">
    Yeni fikirler üzerinde çalışıyoruz. İlk yazımızı burada paylaşacağız.
  </p>
)}

<style>
  .journal-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 0 48px;
    border-top: 1px solid var(--ink);
    padding-top: 28px;
  }
  .journal-article {
    display: grid;
    grid-template-columns: minmax(120px, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  .journal-article:nth-child(2) {
    padding-top: 0;
  }
  .journal-featured {
    grid-column: 1;
    grid-row: span 2;
    display: block;
    padding: 0 0 24px;
    border-bottom: 0;
  }
  .journal-extra {
    margin-top: 32px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  .journal-cover {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: #dfe0dc;
  }
  .journal-featured .journal-cover {
    aspect-ratio: 16 / 9;
  }
  .journal-cover :global(.cover-media) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  .journal-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.2, 0.65, 0.25, 1);
  }
  .journal-issue {
    position: absolute;
    bottom: 10px;
    left: 12px;
    color: white;
    font-size: 36px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.06em;
    text-shadow: 0 2px 10px #0008;
  }
  .journal-latest {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 7px 12px;
    color: white;
    background: var(--wine);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.15em;
  }
  .journal-featured .journal-copy {
    padding-top: 22px;
  }
  .journal-category {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 12px;
    color: var(--wine);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.03em;
  }
  .journal-category span {
    color: var(--muted);
    font-weight: 400;
  }
  .journal-copy h2,
  .journal-copy h3 {
    margin: 14px 0 0;
    font-size: clamp(22px, 2vw, 29px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-wrap: pretty;
    transition: color 0.25s;
  }
  .journal-featured h2,
  .journal-featured h3 {
    font-size: clamp(28px, 3.1vw, 44px);
    max-width: 22ch;
  }
  .journal-description {
    color: var(--muted);
    font-size: 14px;
    margin-top: 16px;
    max-width: 50ch;
    line-height: 1.7;
  }
  .journal-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-top: 22px;
  }
  .journal-bottom > div {
    display: grid;
    gap: 3px;
    font-size: 10px;
    color: var(--muted);
  }
  .journal-arrow {
    font-size: 28px;
    line-height: 1;
    transition:
      transform 0.3s,
      color 0.3s;
  }
  .journal-article:hover h2,
  .journal-article:hover h3 {
    color: var(--wine);
  }
  .journal-article:hover .journal-arrow {
    transform: translate(3px, -3px);
    color: var(--wine);
  }
  .journal-article:hover :global(img) {
    transform: scale(1.035);
  }
  .journal-article:focus-visible {
    outline: 2px solid var(--wine);
    outline-offset: 8px;
  }
  .journal-empty {
    padding: 40px 0;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1000px) {
    .journal-grid {
      gap: 0 28px;
    }
    .journal-article {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .journal-cover {
      aspect-ratio: 16/9;
    }
    .journal-copy h2,
    .journal-copy h3 {
      font-size: 24px;
    }
    .journal-featured h2,
    .journal-featured h3 {
      font-size: 36px;
    }
  }
  @media (max-width: 700px) {
    .journal-grid {
      grid-template-columns: 1fr;
      padding-top: 20px;
    }
    .journal-featured {
      grid-row: auto;
      border-bottom: 1px solid var(--line);
    }
    .journal-article:not(.journal-featured) {
      grid-template-columns: 110px minmax(0, 1fr);
      gap: 18px;
      padding: 24px 0;
    }
    .journal-article:not(.journal-featured) .journal-cover {
      aspect-ratio: 3/2;
    }
    .journal-copy h2,
    .journal-copy h3 {
      font-size: 20px;
      margin-top: 10px;
    }
    .journal-featured h2,
    .journal-featured h3 {
      font-size: 32px;
    }
    .journal-bottom {
      margin-top: 16px;
    }
    .journal-category {
      font-size: 9px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journal-cover :global(img),
    .journal-arrow,
    .journal-copy h2,
    .journal-copy h3 {
      transition: none;
    }
    .journal-article:hover :global(img),
    .journal-article:hover .journal-arrow {
      transform: none;
    }
  }
</style>
