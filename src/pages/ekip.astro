---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { team } from '../content/data';
---

<Base title="Ekip">
  <PageIntro
    eyebrow="İNSANLAR / ORTAK ENERJİ"
    title="İşin içinde biz varız."
    text="Birlikte öğrenmeye alan açan, fikirleri buluşmalara dönüştüren ekip."
  />
  <section class="wrap section-space">
    <div class="section-heading">
      <p class="eyebrow">2026–2027 / ÖRNEK EKİP</p>
      <p class="caption">İsimler ve roller temsilidir.</p>
    </div>
    <div class="team-grid">
      {team.map((member, i) => (
        <article class="team-card" data-reveal>
          <div class={`team-avatar avatar-${i % 3}`} aria-hidden="true">
            <span>{member.initials}</span>
            <i>✳</i>
            <small>HSD / PEOPLE</small>
          </div>
          <h2>{member.name}</h2>
          <p>{member.role}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
