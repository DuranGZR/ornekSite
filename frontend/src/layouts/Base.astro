---
import '@fontsource-variable/manrope';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeLatinExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/interior.css';
import '../styles/mobile.css';
import { site, navigation } from '../config/site';
import StateGlyph from '../components/StateGlyph.astro';
import { siteVisuals } from '../content/visuals';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.description } = Astro.props;
const path = Astro.url.pathname;
const pageDescriptions: Record<string, string> = {
  '/topluluk/':
    'HSD İnönü kimdir? İnönü Üniversitesi Huawei Student Developers topluluğunun misyonu, vizyonu ve ortak değerleri.',
  '/ekip/':
    'HSD İnönü core team: topluluk yönetimi, başkan yardımcıları ve sosyal medya, DevOps, etkinlik komiteleri.',
  '/yazilar/':
    'HSD İnönü Medium yazıları: yazılım, yapay zekâ ve teknoloji üzerine topluluktan yayınlar.',
  '/katil/':
    'HSD İnönü topluluk kayıt bağlantısı, core team başvurusu ve katılım hakkında bilgiler.',
  '/etkinlikler/':
    'HSD İnönü etkinlik arşivi: zirveler, teknik geziler, sektör sohbetleri ve duyuru afişleri.',
};
const pageDescription =
  Astro.props.description ?? pageDescriptions[path] ?? description;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Birlikte, daha ileri.`;
const canonical = new URL(path, site.origin);
const shareImage = new URL('/social-card.png', site.origin);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={manropeLatinExt}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={pageDescription} />
    {Astro.props.noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#eeefed" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />
    <meta property="og:type" content="website" />
  </head>
  <body id="top">
    <div class="scroll-progress" aria-hidden="true">
      <i></i>
    </div>
    <a class="skip-link" href="#main">
      İçeriğe geç
    </a>
    <header class="header">
      <a class="brand" href="/" aria-label="HSD İnönü ana sayfa">
        <img
          class="brand-image"
          src={siteVisuals.logo.image}
          width={siteVisuals.logo.width}
          height={siteVisuals.logo.height}
          alt={siteVisuals.logo.alt}
        />
        <span class="brand-campus">
          <strong>İnönü</strong>
          <small>Üniversitesi</small>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Ana menü">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <a class="pill dark join-link" href="/katil/">
          Bize katıl <span>↗</span>
        </a>
        <button
          class="menu-toggle"
          aria-label="Menüyü aç"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav id="mobile-nav" class="mobile-nav" hidden aria-label="Mobil menü">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
            <span>↗</span>
          </a>
        ))}
        <a href="/katil/">
          Bize katıl <span>↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <template id="image-fallback-template">
      <span class="image-fallback">
        <StateGlyph />
        <span>Görsel yüklenemedi</span>
      </span>
    </template>
    <footer class="footer">
      <div class="footer-grid">
        <div class="footer-identity">
          <a class="brand" href="/">
            <img
              class="brand-image"
              src={siteVisuals.logo.image}
              width={siteVisuals.logo.width}
              height={siteVisuals.logo.height}
              alt={siteVisuals.logo.alt}
            />
            <span class="brand-campus">
              <strong>İnönü</strong>
              <small>Üniversitesi</small>
            </span>
          </a>
          <p>
            Huawei Student Developers
            <br />
            İnönü Üniversitesi · Malatya
          </p>
        </div>
        <nav class="footer-links" aria-label="Alt menü">
          <h2>Keşfet</h2>
          {navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <nav class="footer-links footer-social" aria-label="Sosyal hesaplar">
          <h2>Bizi takip et</h2>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            Instagram <span aria-hidden="true">↗</span>
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a href={site.medium} target="_blank" rel="noopener noreferrer">
            Medium <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} HSD İnönü</span>
      </div>
    </footer>
    <a class="back-to-top" href="#top" aria-label="Sayfanın başına dön" hidden>
      ↑
    </a>
    <script>
      import { initImageFallbacks } from '../scripts/image-fallback';
      initImageFallbacks();
      if (document.querySelector('.campus-hero')) {
        import('../scripts/site-motion').then(({ initSiteMotion }) =>
          initSiteMotion(),
        );
      } else {
        import('../scripts/native-motion').then(({ initNativeNavigation }) =>
          initNativeNavigation(),
        );
      }
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      function closeMenu() {
        if (!toggle || !menu) return;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Menüyü aç');
        menu.hidden = true;
      }
      toggle?.addEventListener('click', () => {
        if (!menu) return;
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
        menu.hidden = !open;
      });
      document.addEventListener('keydown', (e) => {
        if (
          e.key === 'Escape' &&
          toggle?.getAttribute('aria-expanded') === 'true'
        ) {
          closeMenu();
          toggle.focus();
        }
      });
      matchMedia('(min-width: 901px)').addEventListener('change', closeMenu);
      menu?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) closeMenu();
      });
      document.addEventListener('click', (event) => {
        if (!(event.target as Element).closest('.header')) closeMenu();
      });
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      if (!reduced.matches) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          el.classList.add('will-reveal');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
