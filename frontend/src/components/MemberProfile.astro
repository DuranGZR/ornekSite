<dialog id="member-profile" class="member-profile" aria-labelledby="member-profile-name" aria-describedby="member-profile-role" data-lenis-prevent>
  <button type="button" class="member-profile-close" aria-label="Profil kartını kapat" autofocus>×</button>
  <div class="member-profile-photo">
    <img data-profile-photo alt="" width="320" height="320" hidden />
    <span data-profile-initials aria-hidden="true"></span>
  </div>
  <div class="member-profile-copy">
    <h2 id="member-profile-name"></h2>
    <p id="member-profile-role"></p>
  </div>
</dialog>

<script>
  const profile = document.querySelector<HTMLDialogElement>('#member-profile');
  if (profile) {
    const photo = profile.querySelector<HTMLImageElement>('[data-profile-photo]')!;
    const initials = profile.querySelector<HTMLElement>('[data-profile-initials]')!;
    const name = profile.querySelector<HTMLElement>('#member-profile-name')!;
    const role = profile.querySelector<HTMLElement>('#member-profile-role')!;
    const mobile = window.matchMedia('(max-width: 700px)');
    let previousOverflow = '';
    let opener: HTMLButtonElement | null = null;

    photo.addEventListener('error', () => {
      photo.hidden = true;
      initials.hidden = false;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-member-profile]').forEach(button => {
      button.addEventListener('click', () => {
        if (!mobile.matches || profile.open) return;
        const member = button.closest<HTMLElement>('[data-member-name]');
        if (!member) return;
        name.textContent = member.dataset.memberName ?? '';
        role.textContent = member.dataset.memberRole ?? '';
        initials.textContent = member.dataset.memberInitials ?? '';
        const source = member.dataset.memberPhoto;
        photo.hidden = !source;
        initials.hidden = Boolean(source);
        photo.alt = member.dataset.memberName ?? '';
        if (source) photo.src = source;
        else photo.removeAttribute('src');
        opener = button;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        profile.showModal();
      });
    });
    profile.querySelector('button')?.addEventListener('click', () => profile.close());
    profile.addEventListener('click', event => {
      if (event.target !== profile) return;
      const bounds = profile.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) profile.close();
    });
    profile.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      if (mobile.matches) opener?.focus({ preventScroll: true });
    });
    mobile.addEventListener('change', () => {
      if (!mobile.matches && profile.open) profile.close();
    });
  }
</script>

<style>
  .member-profile {
    width: min(320px, calc(100vw - 48px));
    max-height: calc(100svh - 48px);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 22px;
    color: var(--ink);
    background: #f7f5f0;
    box-shadow: 0 24px 80px #0003;
  }
  .member-profile::backdrop { background: #20212580; }
  .member-profile-close {
    position: absolute;
    z-index: 1;
    top: 10px;
    right: 10px;
    width: 44px;
    height: 44px;
    border: 1px solid #20212520;
    border-radius: 50%;
    background: #f7f5f0ee;
    color: var(--ink);
    font-size: 28px;
    cursor: pointer;
  }
  .member-profile-photo {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #eee2e6;
    color: var(--wine);
    font-size: 72px;
  }
  .member-profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member-profile-copy { padding: 24px 20px 28px; text-align: center; }
  .member-profile-copy h2 { font-size: 26px; line-height: 1.2; }
  .member-profile-copy p { margin-top: 8px; color: var(--wine); font-size: 15px; }
</style>
