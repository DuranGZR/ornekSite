    <a href="#kesfet">
      AŞAĞIDA DAHA FAZLASI VAR <span>↓</span>
    </a>
    <span>BAĞLANTI KUR, İZ BIRAK.</span>
  </div>
</section>
<script>
  const host = document.querySelector('#sculpture');
  if (host) {
    const observer = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        try {
          const { initSculpture } = await import('../scripts/sculpture');
          initSculpture();
        } catch {
          const button = host.querySelector<HTMLButtonElement>('.scene-toggle');
          if (button) button.hidden = true;
        }
      },
      { rootMargin: '200px' },
    );
    observer.observe(host);
  }
</script>
