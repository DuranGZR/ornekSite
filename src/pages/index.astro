---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { events, articles, photo } from '../content/data';
import '../styles/home.css';
const words =
  'Aynı kampüste, farklı hayallerle. Birbirimizden öğreniyor, birlikte deniyor, birlikte üretiyoruz.'.split(
    ' ',
  );
---

<Base>
  <Hero />
  <section class="community-story" id="kesfet">
    <div class="wrap">
      <p class="eyebrow">01 / MERAK BİZİ BİR ARAYA GETİRİR</p>
      <h2 class="story-title">
        <span>Bir merak.</span>
        <span>Bin olasılık.</span>
      </h2>
      <div class="story-description">
        <span class="story-star" aria-hidden="true">
          ✳
        </span>
        <div>
          <p aria-label={words.join(' ')}>
            {words.map((word) => (
              <span aria-hidden="true">{word} </span>
            ))}
          </p>
          <a class="text-link" href="/topluluk/">
            HSD İnönü’yü tanı ↗
          </a>
        </div>
      </div>
    </div>
    <a class="community-frame" href="/ekip/">
      <img
        src={photo('photo-1522071820081-009f0129c71c', 1800)}
        alt="Bir masanın etrafında birlikte çalışan gençler"
        loading="lazy"
      />
      <div>
        <span class="eyebrow">FARKLI YETENEKLER. ORTAK HEYECAN.</span>
        <h3>
          İyi ki
          <br />
          bir aradayız.
        </h3>
        <span class="pill light">Ekiple tanış ↗</span>
      </div>
      <small>Temsili topluluk fotoğrafı</small>
    </a>
  </section>
  <section class="event-showcase wrap">
    <div class="section-heading" data-rise>
      <div>
        <p class="eyebrow">02 / TANIŞ. DENE. HATIRLA.</p>
        <h2>
          Takvimden taşan
          <br />
          <em>deneyimler.</em>
        </h2>
      </div>
      <a class="pill outline" href="/etkinlikler/">
        Tüm etkinlikler ↗
      </a>
    </div>
    <div class="event-stack">
      {events.map((event, i) => (
        <a class="showcase-panel" href={`/etkinlikler/${event.slug}/`}>
          <img src={photo(event.image, 1600)} alt="" loading="lazy" />
          <div class="showcase-top">
            <span>
              0{i + 1} / {event.category}
            </span>
            <span>DEMO ETKİNLİK</span>
          </div>
          <div class="showcase-bottom">
            <h3>{event.title}</h3>
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="home-writing wrap">
    <div class="section-heading" data-rise>
      <div>
        <p class="eyebrow">03 / TOPLULUKTAN NOTLAR</p>
        <h2>
          Paylaştıkça
          <br />
          <em>çoğalır.</em>
        </h2>
      </div>
      <a class="text-link" href="/yazilar/">
        Bütün yazılar ↗
      </a>
    </div>
    {articles.map((article, i) => (
      <a
        class="home-article"
        href={article.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="article-symbol" aria-hidden="true">
          {['✳', '↗', '⌘'][i % 3]}
        </span>
        <div>
          <span class="eyebrow">{article.category} / MEDIUM</span>
          <h3>{article.title}</h3>
        </div>
        <span class="article-go" aria-hidden="true">
          ↗
        </span>
      </a>
    ))}
  </section>
  <section class="join-journey">
    <div class="journey-stage">
      <div class="journey-door" aria-hidden="true">
        <span>
          hsd
          <br />
          <small>İNÖNÜ</small>
        </span>
      </div>
      <div class="journey-copy">
        <p class="eyebrow">BİR SONRAKİ ADIMI BİRLİKTE ATALIM.</p>
        <h2>
          Sonraki hikâyede
          <br />
          <em>sen de varsın.</em>
        </h2>
        <a class="pill light" href="/katil/">
          Topluluğa katıl ↗
        </a>
      </div>
      <span class="journey-caption">MERAKINI AL, GEL.</span>
    </div>
  </section>
</Base>
<script>
  import { initHomeMotion } from '../scripts/home-motion';
  initHomeMotion();
</script>
