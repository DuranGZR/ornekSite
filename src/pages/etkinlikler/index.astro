---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import EventCard from '../../components/EventCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { events } from '../../content/data';
---

<Base title="Etkinlikler">
  <PageIntro
    eyebrow="BULUŞ / DENE / ÜRET"
    title="Takvimde yer aç."
    text="Bir atölye, yeni bir fikir ya da sadece güzel bir sohbet. Bir sonraki buluşmayı keşfet."
  />
  <section class="wrap section-space" data-filter-root>
    <div class="filter-toolbar">
      <FilterBar categories={['Atölye', 'Söyleşi', 'Buluşma']} />
      <label class="period-label">
        Dönem{' '}
        <select data-period>
          <option value="all">Tüm etkinlikler</option>
          <option value="upcoming">Yaklaşan</option>
          <option value="past">Geçmiş</option>
        </select>
      </label>
    </div>
    <p class="caption">Tarihler ve etkinlik bilgileri tasarım için örnektir.</p>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <div class="event-grid">
      {events.map((event) => (
        <div data-category={event.category} data-date={event.date}>
          <EventCard event={event} />
        </div>
      ))}
    </div>
    <div class="empty-state" data-empty hidden>
      <h2>Şimdilik burada bir buluşma yok.</h2>
      <p>
        Başka bir filtre deneyebilir veya yeni duyurular için sosyal
        hesaplarımızı takip edebilirsin.
      </p>
      <a href="https://www.instagram.com/hsdinonu/" class="text-link">
        Instagram'a git ↗
      </a>
    </div>
  </section>
</Base>
