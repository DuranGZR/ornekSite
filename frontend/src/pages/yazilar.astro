---
import Base from '../layouts/Base.astro';
import PublicationGrid from '../components/PublicationGrid.astro';
import { articles } from '../content/data';
import { site } from '../config/site';
---

<Base title="Yazılar">
  <div class="interior journal-page wrap">
    <header class="journal-heading">
      <div class="journal-topline">
        <p class="eyebrow">HSD İNÖNÜ / YAZILAR</p>
        <a
          href={site.medium}
          target="_blank"
          rel="noopener noreferrer"
          class="medium-signature"
          aria-label="HSD İnönü Medium yayınlarını aç"
        >
          Medium <span aria-hidden="true">↗</span>
        </a>
      </div>
      <h1>
        Merakın <em>satır araları.</em>
      </h1>
      <div class="journal-subline">
        <p>Teknoloji, yeni fikirler ve topluluğun kaleminden hikâyeler.</p>
        <span>ÖĞREN. DÜŞÜN. PAYLAŞ.</span>
      </div>
    </header>
    <section aria-label="Medium yayınları">
      <PublicationGrid
        articles={[...articles]
          .sort((a, b) => b.published.localeCompare(a.published))
          .slice(0, 5)}
      />
    </section>
    <div class="journal-end">
      <p>Bir sonraki fikir, bir sonraki satırda.</p>
      <a
        class="text-link"
        href={site.medium}
        target="_blank"
        rel="noopener noreferrer"
      >
        Medium’da keşfet <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</Base>

<style>
  .journal-heading {
    padding: 64px 0 36px;
  }
  .journal-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }
  .medium-signature {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: Georgia, serif;
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.06em;
  }
  .medium-signature span {
    font:
      18px 'Manrope Variable',
      sans-serif;
  }
  .journal-heading h1 {
    font-size: clamp(44px, 6.5vw, 100px);
    letter-spacing: -0.065em;
  }
  .journal-subline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
  }
  .journal-subline > span {
    font-size: 9px;
    letter-spacing: 0.16em;
    flex-shrink: 0;
  }
  .journal-end {
    margin: 52px 0 100px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 24px;
    justify-content: space-between;
    align-items: center;
  }
  .journal-end p {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 700px) {
    .journal-heading {
      padding: 40px 0 28px;
    }
    .medium-signature {
      font-size: 21px;
    }
    .journal-subline > span {
      display: none;
    }
    .journal-heading h1 em {
      display: block;
    }
    .journal-end {
      flex-direction: column;
      align-items: start;
      margin-bottom: 64px;
    }
  }
</style>
