---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { photo } from '../content/data';
---

<Base title="Topluluk">
  <PageIntro
    eyebrow="BİZ / HSD İNÖNÜ"
    title="Ortak noktamız: merak."
    text="Farklı disiplinlerden geliyoruz. Teknolojiyi anlamak, yeni şeyler denemek ve öğrendiklerimizi paylaşmak için bir araya geliyoruz."
  />
  <section class="wrap">
    <img
      class="wide-photo"
      src={photo('photo-1522071820081-009f0129c71c', 1600)}
      alt="Birlikte çalışan öğrencileri temsil eden fotoğraf"
      width="1600"
      height="900"
    />
    <p class="caption">Topluluk atmosferini temsil eden görsel.</p>
    <div class="values-grid section-space">
      {[
        [
          '01',
          'Öğren.',
          'Soru sormaya, bilmediğini söylemeye ve ilk adımı atmaya alan açıyoruz.',
        ],
        [
          '02',
          'Dene.',
          'Fikirlerimizi küçük denemelerle somutlaştırıyor, birlikte geliştiriyoruz.',
        ],
        [
          '03',
          'Paylaş.',
          'Deneyimlerimizi yazılara, sohbetlere ve etkinliklere taşıyoruz.',
        ],
      ].map(([n, title, text]) => (
        <article data-reveal>
          <p class="eyebrow">{n}</p>
          <h2>{title}</h2>
          <p>{text}</p>
        </article>
      ))}
    </div>
    <section class="split-section section-space">
      <h2>
        Her meraka
        <br />
        bir alan.
      </h2>
      <div class="areas">
        {[
          'Yazılım geliştirme',
          'Yapay zekâ',
          'Tasarım ve deneyim',
          'Teknoloji ve paylaşım',
        ].map((area, i) => (
          <div>
            <span>0{i + 1}</span>
            <h3>{area}</h3>
            <span>↗</span>
          </div>
        ))}
      </div>
    </section>
    <section class="split-section section-space">
      <h2>
        Aklında
        <br />
        bir soru mu var?
      </h2>
      <div class="faq">
        {[
          [
            'HSD İnönü nedir?',
            'İnönü Üniversitesi çevresinde teknolojiye ilgi duyan insanları bir araya getiren HSD topluluğudur.',
          ],
          [
            'Yazılım bilmem gerekiyor mu?',
            'Merak etmek ve öğrenmeye açık olmak iyi bir başlangıç. Etkinliklerin ön koşulları varsa ilgili detay sayfasında belirtilir.',
          ],
          [
            'Duyuruları nereden takip edebilirim?',
            'Instagram ve LinkedIn hesaplarımızı takip edebilir, sitedeki etkinlikleri inceleyebilirsin.',
          ],
        ].map(([q, a]) => (
          <details>
            <summary>
              {q}
              <span>+</span>
            </summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </section>
</Base>
